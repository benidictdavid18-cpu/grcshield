# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
DATABASE_URL=postgresql+psycopg://grcshield:grcshield@localhost:5432/grcshield
ENVIRONMENT=development

# Signs the JWTs. The built-in default is a placeholder, not a secret; set this to a
# long random value for anything that is not a local demo.
JWT_SECRET=dev-only-not-a-secret-change-me

# Demo credentials, published in the README on purpose.
DEMO_AUDITOR_USERNAME=auditor
DEMO_AUDITOR_PASSWORD=auditor-demo-2026
DEMO_MANAGER_USERNAME=isms.manager
DEMO_MANAGER_PASSWORD=manager-demo-2026
