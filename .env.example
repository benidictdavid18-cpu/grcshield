# Copy to .env for local (non-Docker) runs. Docker Compose sets these itself.
DATABASE_URL=postgresql+psycopg://grcshield:grcshield@localhost:5432/grcshield
ENVIRONMENT=development

# Signs the JWTs. The built-in default is a placeholder, not a secret; set this to a
# long random value for anything that is not a local demo.
JWT_SECRET=dev-only-not-a-secret-change-me

# Demo credentials, published in the README on purpose.
DEMO_AUDITOR_USERNAME=auditor
DEMO_AUDITOR_PASSWORD=auditor-demo-2026
DEMO_MANAGER_USERNAME=isms.manager
DEMO_MANAGER_PASSWORD=manager-demo-2026

# --- Local AI assistant (Ollama) --------------------------------------------
# Entirely optional. With AI_ENABLED=false, or with Ollama simply not running, every
# GRC feature in this application works exactly as it does today; the assistant panels
# report that they are unavailable and nothing else changes.
#
# Setup:
#   1. Install Ollama            https://ollama.com/download
#   2. ollama pull llama3.2:3b   (or any model you prefer; see OLLAMA_MODEL)
#   3. ollama serve              (the desktop app does this for you)
AI_ENABLED=true

# Ollama has no authentication of its own. Keep this on loopback or a private network;
# the application logs a warning at start-up if it is pointed anywhere else.
# From inside Docker Compose, use http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# Any model Ollama holds. Nothing in the code depends on this one -- /ai/status reports
# plainly when the configured model is not present, and tells you how to pull it.
# Smaller models answer faster and hallucinate more; both are visible in the UI.
OLLAMA_MODEL=llama3.2:3b

# Seconds. A large model on a cold start can take longer than this on a laptop; a
# timeout is a 503 and an explanation, never a failure of anything else.
OLLAMA_TIMEOUT=60

# Ceiling on record content sent to the model in one request, in characters. Bounds the
# prompt, the latency, and the blast radius of one pathological record.
AI_MAX_INPUT_CHARS=12000

# Ceiling on the analyst's optional free-text question. Small on purpose: it is a
# question about a record, not a channel for supplying a system prompt.
AI_MAX_QUESTION_CHARS=500

# How long /ai/status answers from a cached probe. The status chip is on every page.
AI_STATUS_CACHE_SECONDS=30

# Ask Ollama to constrain generation to the response JSON schema. Falls back to plain
# JSON mode automatically on an Ollama build that rejects a schema.
AI_STRUCTURED_OUTPUT=true

# Context window Ollama should allocate, in tokens. Ollama defaults to 4096 whatever the
# model supports, and silently truncates a longer prompt rather than refusing it. The
# largest prompt here -- the Annex A catalogue plus a full risk record -- runs close to
# that ceiling. Raise this if you raise AI_MAX_INPUT_CHARS.
OLLAMA_NUM_CTX=8192
